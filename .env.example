# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SERVER PORT: Default 3000 for AI Studio dev server
PORT=3000

# SUPABASE POSTGRESQL & AUTH CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# VITE CLIENT-SIDE SUPABASE CREDENTIALS (for client-side auth & realtime subscriptions)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Obtain these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"

# N8N AUTOMATION WEBHOOKS
# Configure URLs from your n8n workflow webhook triggers
N8N_WEBHOOK_NEW_APPLICATION="https://n8n.yourdomain.com/webhook/asaw-new-application"
N8N_WEBHOOK_STATUS_CHANGED="https://n8n.yourdomain.com/webhook/asaw-status-changed"
N8N_WEBHOOK_NEW_DOCUMENT="https://n8n.yourdomain.com/webhook/asaw-new-document"
N8N_WEBHOOK_PAYMENT_COMPLETED="https://n8n.yourdomain.com/webhook/asaw-payment-completed"
N8N_WEBHOOK_CONTACT_ENQUIRY="https://n8n.yourdomain.com/webhook/asaw-contact-enquiry"

# EMAIL SMTP CONFIGURATION (Gmail or custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="asawconsultancy@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ASAW Consultancy Services <asawconsultancy@gmail.com>"
